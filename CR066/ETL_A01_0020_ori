WITH
SCE_PER_AREA_ORI AS (
    SELECT
        SCENARIO_PERIODO_AREA.COD_SCENARIO AS COD_SCENARIO
        , SCENARIO.COD_SCENARIO_ORIGINARIO AS COD_SCENARIO_ORIGINARIO
        , PERC_INTERESSENZA
        , PERC_PROPORZIONALITA
        , TIPO_CONSOLIDAMENTO
        , TIPO_DECONSOLIDAMENTO
        , SCENARIO.COD_AZI_CAPOGRUPPO
        , SCENARIO_PERIODO_AREA.COD_PERIODO
        , SCENARIO_PERIODO_AREA.COD_AZIENDA
    FROM
        SCENARIO_PERIODO_AREA
    LEFT JOIN
        SCENARIO
    ON
        SCENARIO_PERIODO_AREA.COD_SCENARIO = SCENARIO.COD_SCENARIO
        
),

CONS_SCO_CHK_INT_OLD AS (
    SELECT
        *
    FROM
        {AW|001|000060|TPL001|{PROCESS}|{PAR_0010}|{PAR_0020}|$} AS CONS_SCO_CHK_DATASET    
    WHERE
        CONS_SCO_CHK_DATASET.COD_SCENARIO_AW = {PAR_0010}
        AND COALESCE(COD_DEST3,'') <> 'CH99'
        AND COALESCE(COD_DEST4,'') <> 'ZZZZ'
        AND COALESCE(COD_DEST5,'') <> 'ZZZZ'
        AND NOT COD_DEST3 IS NULL
        AND NOT COD_DEST4 IS NULL
        AND NOT COD_DEST5 IS NULL
),

CONS_SCO_CHK_DEC1_DEC3_TXT013 AS (
    SELECT
        OID,
        CONS_SCO_CHK_DATASET.COD_SCENARIO AS COD_SCENARIO,
        CONS_SCO_CHK_DATASET.COD_PERIODO,
        CONS_SCO_CHK_DATASET.COD_AZIENDA,
        CONS_SCO_CHK_DATASET.COD_AZI_CTP,
        CONS_SCO_CHK_DATASET.COD_CATEGORIA,
        'GEN' AS COD_DEST3,
        'GEN' AS COD_DEST4,
        'GEN' AS COD_DEST5,
        CONS_SCO_CHK_DATASET.COD_SCENARIO_AW,
        INT_001,
        INT_002,
        INT_003,
        INT_004,
        INT_005,
        DECIMAL_001,
        DECIMAL_002,
        SCE_PER_AREA_ORI.PERC_INTERESSENZA/100 AS DECIMAL_003,
        DECIMAL_004,
        DECIMAL_005,
        SCE_PER_AREA_ORI.PERC_PROPORZIONALITA/100 AS DECIMAL_006,
        DECIMAL_007,
        TEXT_001,
        TEXT_002,
        TEXT_003,
        SCE_PER_AREA_ORI.TIPO_CONSOLIDAMENTO AS TEXT_004,
        TEXT_005,
        TEXT_006,
        TEXT_007,
        TEXT_008,
        TEXT_009,
        TEXT_010,
        TEXT_011,
        TEXT_012,
        SCE_PER_AREA_ORI.TIPO_DECONSOLIDAMENTO AS TEXT_013
    FROM
         {AW|001|000060|TPL001|{PROCESS}|{PAR_0010}|{PAR_0020}|$} AS CONS_SCO_CHK_DATASET
    LEFT JOIN
         SCE_PER_AREA_ORI
    ON
        CONS_SCO_CHK_DATASET.COD_SCENARIO = SCE_PER_AREA_ORI.COD_SCENARIO_ORIGINARIO
        AND CONS_SCO_CHK_DATASET.COD_PERIODO = SCE_PER_AREA_ORI.COD_PERIODO
        AND CONS_SCO_CHK_DATASET.COD_AZIENDA = SCE_PER_AREA_ORI.COD_AZIENDA
        AND CONS_SCO_CHK_DATASET.COD_AZI_CTP = SCE_PER_AREA_ORI.COD_AZI_CAPOGRUPPO
        AND CONS_SCO_CHK_DATASET.COD_SCENARIO_AW = SCE_PER_AREA_ORI.COD_SCENARIO
    WHERE
        CONS_SCO_CHK_DATASET.COD_SCENARIO_AW = {PAR_0030}
        AND COALESCE(COD_DEST3,'') <> 'CH99'
        AND COALESCE(COD_DEST4,'') <> 'ZZZZ'
        AND COALESCE(COD_DEST5,'') <> 'ZZZZ'
),

CONS_SCO_CHK_INT_001 AS (
    SELECT
        OID,
        CONS_SCO_CHK_DEC1_DEC3_TXT013.COD_SCENARIO AS COD_SCENARIO,
        CONS_SCO_CHK_DEC1_DEC3_TXT013.COD_PERIODO,
        CONS_SCO_CHK_DEC1_DEC3_TXT013.COD_AZIENDA,
        CONS_SCO_CHK_DEC1_DEC3_TXT013.COD_AZI_CTP,
        CONS_SCO_CHK_DEC1_DEC3_TXT013.COD_CATEGORIA,
        CONS_SCO_CHK_DEC1_DEC3_TXT013.COD_DEST3,
        CONS_SCO_CHK_DEC1_DEC3_TXT013.COD_DEST4,
        CONS_SCO_CHK_DEC1_DEC3_TXT013.COD_DEST5,
        DATI_SALDI_IC_A1003.COD_SCENARIO_AW,
        DATI_SALDI_IC_A1003.IMPORTO AS INT_001,
        INT_002,
        INT_003,
        INT_004,
        INT_005,
        DECIMAL_001,
        DECIMAL_002,
        DECIMAL_003,
        DECIMAL_004,
        DECIMAL_005,
        DECIMAL_006,
        DECIMAL_007,
        TEXT_001,
        TEXT_002,
        TEXT_003,
        TEXT_004,
        TEXT_005,
        TEXT_006,
        TEXT_007,
        TEXT_008,
        TEXT_009,
        TEXT_010,
        TEXT_011,
        TEXT_012,
        TEXT_013
    FROM
        CONS_SCO_CHK_DEC1_DEC3_TXT013
    LEFT JOIN
        (
            SELECT
                COD_SCENARIO,
                COD_PERIODO,
                COD_AZIENDA,
                COD_AZI_CTP,
                {PAR_0030} AS COD_SCENARIO_AW,
                SUM(IMPORTO) AS IMPORTO
            FROM
                DATI_SALDI_IC
            WHERE
                COD_CONTO = 'A1003'
                AND COD_CATEGORIA = '00_01X05_X0_A010'
            GROUP BY
                COD_SCENARIO,
                COD_PERIODO,
                COD_AZIENDA,
                COD_AZI_CTP
            UNION ALL
            SELECT
                COD_SCENARIO,
                COD_PERIODO,
                COD_AZIENDA,
                COD_AZI_CTP,
                {PAR_0010} AS COD_SCENARIO_AW,
                SUM(IMPORTO) AS IMPORTO
            FROM
                DATI_SALDI_IC
            WHERE
                COD_CONTO = 'A1003'
                AND COD_CATEGORIA = '00_01001_R0_A010'
            GROUP BY
                COD_SCENARIO,
                COD_PERIODO,
                COD_AZIENDA,
                COD_AZI_CTP
        ) AS DATI_SALDI_IC_A1003
    ON
        CONS_SCO_CHK_DEC1_DEC3_TXT013.COD_SCENARIO        = DATI_SALDI_IC_A1003.COD_SCENARIO
        AND CONS_SCO_CHK_DEC1_DEC3_TXT013.COD_PERIODO     = DATI_SALDI_IC_A1003.COD_PERIODO
        AND CONS_SCO_CHK_DEC1_DEC3_TXT013.COD_AZIENDA     = DATI_SALDI_IC_A1003.COD_AZIENDA
        AND CONS_SCO_CHK_DEC1_DEC3_TXT013.COD_AZI_CTP     = DATI_SALDI_IC_A1003.COD_AZI_CTP
/*        AND CONS_SCO_CHK_DEC1_DEC3_TXT013.COD_SCENARIO_AW = DATI_SALDI_IC_A1003.COD_SCENARIO_AW
*/
),

CONS_SCO_CHK_INT_002 AS (
    SELECT
        OID,
        CONS_SCO_CHK_INT_001.COD_SCENARIO AS COD_SCENARIO,
        CONS_SCO_CHK_INT_001.COD_PERIODO,
        CONS_SCO_CHK_INT_001.COD_AZIENDA,
        CONS_SCO_CHK_INT_001.COD_AZI_CTP,
        CONS_SCO_CHK_INT_001.COD_CATEGORIA,
        CONS_SCO_CHK_INT_001.COD_DEST3,
        CONS_SCO_CHK_INT_001.COD_DEST4,
        CONS_SCO_CHK_INT_001.COD_DEST5,
        CONS_SCO_CHK_INT_001.COD_SCENARIO_AW,
        INT_001,
        DATI_SALDI_IC_A1001.IMPORTO AS INT_002,
        INT_003,
        INT_004,
        INT_005,
        DECIMAL_001,
        DECIMAL_002,
        DECIMAL_003,
        DECIMAL_004,
        DECIMAL_005,
        DECIMAL_006,
        DECIMAL_007,
        TEXT_001,
        TEXT_002,
        TEXT_003,
        TEXT_004,
        TEXT_005,
        TEXT_006,
        TEXT_007,
        TEXT_008,
        TEXT_009,
        TEXT_010,
        TEXT_011,
        TEXT_012,
        TEXT_013
    FROM
        CONS_SCO_CHK_INT_001
    LEFT JOIN
        (
            SELECT
                COD_SCENARIO,
                COD_PERIODO,
                COD_AZIENDA,
                COD_AZI_CTP,
                {PAR_0030} AS COD_SCENARIO_AW,
                SUM(IMPORTO) AS IMPORTO
            FROM
                DATI_SALDI_IC
            WHERE
                COD_CONTO = 'A1001'
                AND COD_CATEGORIA = '00_01X05_X0_A010'
            GROUP BY
                COD_SCENARIO,
                COD_PERIODO,
                COD_AZIENDA,
                COD_AZI_CTP
            UNION ALL
            SELECT
                COD_SCENARIO,
                COD_PERIODO,
                COD_AZIENDA,
                COD_AZI_CTP,
                {PAR_0010} AS COD_SCENARIO_AW,
                SUM(IMPORTO) AS IMPORTO
            FROM
                DATI_SALDI_IC
            WHERE
                COD_CONTO = 'A1001'
                AND COD_CATEGORIA = '00_01001_R0_A010'
            GROUP BY
                COD_SCENARIO,
                COD_PERIODO,
                COD_AZIENDA,
                COD_AZI_CTP
        ) AS DATI_SALDI_IC_A1001
    ON
        CONS_SCO_CHK_INT_001.COD_SCENARIO        = DATI_SALDI_IC_A1001.COD_SCENARIO
        AND CONS_SCO_CHK_INT_001.COD_PERIODO     = DATI_SALDI_IC_A1001.COD_PERIODO
        AND CONS_SCO_CHK_INT_001.COD_AZIENDA     = DATI_SALDI_IC_A1001.COD_AZI_CTP
        AND CONS_SCO_CHK_INT_001.COD_AZI_CTP     = DATI_SALDI_IC_A1001.COD_AZIENDA
/*        AND CONS_SCO_CHK_INT_001.COD_SCENARIO_AW = DATI_SALDI_IC_A1001.COD_SCENARIO_AW
*/
),

CONS_SCO_CHK_INT_003 AS (
    SELECT
        OID,
        CONS_SCO_CHK_INT_002.COD_SCENARIO AS COD_SCENARIO,
        CONS_SCO_CHK_INT_002.COD_PERIODO,
        CONS_SCO_CHK_INT_002.COD_AZIENDA,
        CONS_SCO_CHK_INT_002.COD_AZI_CTP,
        CONS_SCO_CHK_INT_002.COD_CATEGORIA,
        CONS_SCO_CHK_INT_002.COD_DEST3,
        CONS_SCO_CHK_INT_002.COD_DEST4,
        CONS_SCO_CHK_INT_002.COD_DEST5,
        CONS_SCO_CHK_INT_002.COD_SCENARIO_AW,
        INT_001,
        INT_002,
        DATI_SALDI_IC_A1130.IMPORTO AS INT_003,
        INT_004,
        INT_005,
        DECIMAL_001,
        DECIMAL_002,
        DECIMAL_003,
        DECIMAL_004,
        DECIMAL_005,
        DECIMAL_006,
        DECIMAL_007,
        TEXT_001,
        TEXT_002,
        TEXT_003,
        TEXT_004,
        TEXT_005,
        TEXT_006,
        TEXT_007,
        TEXT_008,
        TEXT_009,
        TEXT_010,
        TEXT_011,
        TEXT_012,
        TEXT_013
    FROM
        CONS_SCO_CHK_INT_002
    LEFT JOIN
        (
            SELECT
                COD_SCENARIO,
                COD_PERIODO,
                COD_AZIENDA,
                COD_AZI_CTP,
                {PAR_0030} AS COD_SCENARIO_AW,
                SUM(IMPORTO) AS IMPORTO
            FROM
                DATI_SALDI_IC
            WHERE
                COD_CONTO = 'A1130'
                AND COD_CATEGORIA = '00_01X05_X0_A010'
            GROUP BY
                COD_SCENARIO,
                COD_PERIODO,
                COD_AZIENDA,
                COD_AZI_CTP
            UNION ALL
            SELECT
                COD_SCENARIO,
                COD_PERIODO,
                COD_AZIENDA,
                COD_AZI_CTP,
                {PAR_0010} AS COD_SCENARIO_AW,
                SUM(IMPORTO) AS IMPORTO
            FROM
                DATI_SALDI_IC
            WHERE
                COD_CONTO = 'A1130'
                AND COD_CATEGORIA = 'T0_01002_Z0_A010'
            GROUP BY
                COD_SCENARIO,
                COD_PERIODO,
                COD_AZIENDA,
                COD_AZI_CTP
        ) AS DATI_SALDI_IC_A1130
    ON
        CONS_SCO_CHK_INT_002.COD_SCENARIO        = DATI_SALDI_IC_A1130.COD_SCENARIO
        AND CONS_SCO_CHK_INT_002.COD_PERIODO     = DATI_SALDI_IC_A1130.COD_PERIODO
        AND CONS_SCO_CHK_INT_002.COD_AZIENDA     = DATI_SALDI_IC_A1130.COD_AZIENDA
        AND CONS_SCO_CHK_INT_002.COD_AZI_CTP     = DATI_SALDI_IC_A1130.COD_AZI_CTP
/*        AND CONS_SCO_CHK_INT_002.COD_SCENARIO_AW = DATI_SALDI_IC_A1130.COD_SCENARIO_AW
*/
),

CONS_SCO_CHK_SCE_ALL AS (
    SELECT
        *
    FROM
        (
            SELECT
                COALESCE(CONS_SCO_CHK_INT_OLD.OID, NEWID()) AS OID,
                CONS_SCO_CHK_INT_TMP.COD_SCENARIO AS COD_SCENARIO,
                CONS_SCO_CHK_INT_TMP.COD_PERIODO,
                CONS_SCO_CHK_INT_TMP.COD_AZIENDA,
                CONS_SCO_CHK_INT_TMP.COD_AZI_CTP,
                CONS_SCO_CHK_INT_TMP.COD_CATEGORIA,
                CONS_SCO_CHK_INT_TMP.COD_DEST3,
                CONS_SCO_CHK_INT_TMP.COD_DEST4,
                CONS_SCO_CHK_INT_TMP.COD_DEST5,
                CONS_SCO_CHK_INT_TMP.COD_SCENARIO AS COD_SCENARIO_AW,
                CONS_SCO_CHK_INT_TMP.INT_001,
                CONS_SCO_CHK_INT_TMP.INT_002,
                CONS_SCO_CHK_INT_TMP.INT_003,
                CONS_SCO_CHK_INT_TMP.INT_004,
                CONS_SCO_CHK_INT_TMP.INT_005,
                CONS_SCO_CHK_INT_TMP.DECIMAL_001,
                CONS_SCO_CHK_INT_TMP.DECIMAL_002,
                CONS_SCO_CHK_INT_TMP.DECIMAL_003,
                CONS_SCO_CHK_INT_TMP.DECIMAL_004,
                CONS_SCO_CHK_INT_TMP.DECIMAL_005,
                CONS_SCO_CHK_INT_TMP.DECIMAL_006,
                CONS_SCO_CHK_INT_TMP.DECIMAL_007,
                CONS_SCO_CHK_INT_TMP.TEXT_001,
                CONS_SCO_CHK_INT_TMP.TEXT_002,
                CONS_SCO_CHK_INT_TMP.TEXT_003,
                CONS_SCO_CHK_INT_TMP.TEXT_004,
                CONS_SCO_CHK_INT_TMP.TEXT_005,
                CONS_SCO_CHK_INT_TMP.TEXT_006,
                CONS_SCO_CHK_INT_TMP.TEXT_007,
                CONS_SCO_CHK_INT_TMP.TEXT_008,
                CONS_SCO_CHK_INT_TMP.TEXT_009,
                CONS_SCO_CHK_INT_TMP.TEXT_010,
                CONS_SCO_CHK_INT_TMP.TEXT_011,
                CONS_SCO_CHK_INT_TMP.TEXT_012,
                CONS_SCO_CHK_INT_TMP.TEXT_013
            FROM
                (
                    SELECT
                        *
                    FROM
                        CONS_SCO_CHK_INT_003
                    WHERE
                        INT_001 IS NOT NULL
                        OR
                        INT_002 IS NOT NULL
                        OR
                        INT_003 IS NOT NULL
                ) AS CONS_SCO_CHK_INT_TMP
            LEFT JOIN
                CONS_SCO_CHK_INT_OLD
            ON
                CONS_SCO_CHK_INT_TMP.COD_AZIENDA = CONS_SCO_CHK_INT_OLD.COD_AZIENDA
                AND CONS_SCO_CHK_INT_TMP.COD_AZI_CTP = CONS_SCO_CHK_INT_OLD.COD_AZI_CTP
                AND CONS_SCO_CHK_INT_TMP.COD_DEST3 = CONS_SCO_CHK_INT_OLD.COD_DEST3
                AND CONS_SCO_CHK_INT_TMP.COD_DEST4 = CONS_SCO_CHK_INT_OLD.COD_DEST4
                AND CONS_SCO_CHK_INT_TMP.COD_DEST5 = CONS_SCO_CHK_INT_OLD.COD_DEST5
                AND CONS_SCO_CHK_INT_TMP.COD_SCENARIO = CONS_SCO_CHK_INT_OLD.COD_SCENARIO_AW
        )
    UNION 
    SELECT
        *
    FROM
        CONS_SCO_CHK_INT_003
),

STOCK_RATE AS (
    SELECT 
        SCENARIO.COD_SCENARIO_ORIGINARIO AS COD_SCENARIO_ORIGINARIO,
        STOCK_RATE_DATASET.SCENARIO AS COD_SCENARIO,
        STOCK_RATE_DATASET.OWNING_COMPANY,
        STOCK_RATE_DATASET.OWNED_COMPANY,
        STOCK_RATE_DATASET.PERIOD AS COD_PERIODO,
        EQUITY_RATIO,
        INTERACTION_FLAG
    FROM
         {AW|001|000020|TYP_02|$|$|$|$} AS STOCK_RATE_DATASET
    LEFT JOIN
        SCENARIO
    ON
        STOCK_RATE_DATASET.SCENARIO = SCENARIO.COD_SCENARIO
),

IC_TO_BE_ADDED AS (
    SELECT 
        IC_PART1.COD_SCENARIO,
        IC_PART1.COD_PERIODO,
        IC_PART1.COD_AZIENDA,
        IC_PART1.COD_AZI_CTP
    FROM (
        SELECT
            DISTINCT
            COD_SCENARIO,
            COD_PERIODO,
            COD_AZIENDA,
            COD_DEST1,
            COD_DEST2,
            COD_DEST3,
            COD_DEST4,
            COD_DEST5,
            COD_CATEGORIA,
            COD_DEST2_CTP,
            COD_AZI_CTP
        FROM
            DATI_SALDI_IC
        WHERE
            COD_AZI_CTP = '1010'
            AND COD_CONTO = 'A1001'
    ) AS IC_PART1
    INNER JOIN
    (
        SELECT
            DISTINCT
            COD_SCENARIO,
            COD_PERIODO,
            COD_AZIENDA,
            COD_DEST1,
            COD_DEST2,
            COD_DEST3,
            COD_DEST4,
            COD_DEST5,
            COD_CATEGORIA,
            COD_DEST2_CTP,
            COD_AZI_CTP
        FROM
            DATI_SALDI_IC
        WHERE
            COD_AZI_CTP = '1010'
            AND COD_CONTO = 'A1003'
    ) AS IC_PART2
    ON
        IC_PART1.COD_AZIENDA = IC_PART2.COD_AZIENDA
        AND IC_PART1.COD_SCENARIO = IC_PART2.COD_SCENARIO
        AND IC_PART1.COD_PERIODO = IC_PART2.COD_PERIODO
        AND IC_PART1.COD_DEST1 = IC_PART2.COD_DEST1
        AND IC_PART1.COD_DEST2 = IC_PART2.COD_DEST2
        AND IC_PART1.COD_DEST3 = IC_PART2.COD_DEST3
        AND IC_PART1.COD_DEST4 = IC_PART2.COD_DEST4
        AND IC_PART1.COD_DEST5 = IC_PART2.COD_DEST5
        AND IC_PART1.COD_CATEGORIA = IC_PART2.COD_CATEGORIA
        AND IC_PART1.COD_DEST2_CTP = IC_PART2.COD_DEST2_CTP
),
IC_TO_BE_ADDED2 AS (
    SELECT 
        IC_PART1.COD_SCENARIO,
        IC_PART1.COD_PERIODO,
        IC_PART1.COD_AZIENDA,
        IC_PART1.COD_AZI_CTP
    FROM (
        SELECT
            DISTINCT
            COD_SCENARIO,
            COD_PERIODO,
            COD_AZIENDA,
            COD_DEST1,
            COD_DEST2,
            COD_DEST3,
            COD_DEST4,
            COD_DEST5,
            COD_CATEGORIA,
            COD_DEST2_CTP,
            COD_AZI_CTP
        FROM
            DATI_SALDI_IC
        WHERE
            COD_CONTO = 'A1001'
    ) AS IC_PART1
    INNER JOIN
    (
        SELECT
            DISTINCT
            COD_SCENARIO,
            COD_PERIODO,
            COD_AZIENDA,
            COD_DEST1,
            COD_DEST2,
            COD_DEST3,
            COD_DEST4,
            COD_DEST5,
            COD_CATEGORIA,
            COD_DEST2_CTP,
            COD_AZI_CTP
        FROM
            DATI_SALDI_IC
        WHERE
            COD_CONTO = 'A1003'
    ) AS IC_PART2
    ON
        IC_PART1.COD_AZIENDA       = IC_PART2.COD_AZIENDA
        AND IC_PART1.COD_AZI_CTP   = IC_PART2.COD_AZI_CTP
        AND IC_PART1.COD_SCENARIO  = IC_PART2.COD_SCENARIO
        AND IC_PART1.COD_PERIODO   = IC_PART2.COD_PERIODO
        AND IC_PART1.COD_DEST1     = IC_PART2.COD_DEST1
        AND IC_PART1.COD_DEST2     = IC_PART2.COD_DEST2
        AND IC_PART1.COD_DEST3     = IC_PART2.COD_DEST3
        AND IC_PART1.COD_DEST4     = IC_PART2.COD_DEST4
        AND IC_PART1.COD_DEST5     = IC_PART2.COD_DEST5
        AND IC_PART1.COD_CATEGORIA = IC_PART2.COD_CATEGORIA
        AND IC_PART1.COD_DEST2_CTP = IC_PART2.COD_DEST2_CTP
),

STOCK_RATE_FLAG AS (
    SELECT
        STOCK_RATE_CHK.COD_SCENARIO_ORIGINARIO, 
        STOCK_RATE_CHK.COD_SCENARIO,
        STOCK_RATE_CHK.OWNED_COMPANY,
        STOCK_RATE_CHK.OWNING_COMPANY,
        STOCK_RATE_CHK.COD_PERIODO,
        STOCK_RATE_CHK.EQUITY_RATIO,
        CASE WHEN FLAG_CHK1 IS NOT NULL AND FLAG_CHK2 IS NOT NULL
        THEN 'Y' ELSE STOCK_RATE_CHK.INTERACTION_FLAG END AS INTERACTION_FLAG
    FROM (
        SELECT
            STOCK_RATE.COD_SCENARIO_ORIGINARIO, 
            {PAR_0030} AS COD_SCENARIO,
            STOCK_RATE.OWNED_COMPANY,
            STOCK_RATE.OWNING_COMPANY,
            STOCK_RATE.COD_PERIODO,
            STOCK_RATE.EQUITY_RATIO,
            STOCK_RATE.INTERACTION_FLAG,
            IC_TO_BE_ADDED.COD_AZIENDA AS FLAG_CHK1,
            IC_TO_BE_ADDED.COD_AZI_CTP AS FLAG_CHK2
        FROM
            STOCK_RATE
        LEFT JOIN
            IC_TO_BE_ADDED
        ON
            STOCK_RATE.COD_SCENARIO_ORIGINARIO = IC_TO_BE_ADDED.COD_SCENARIO
/*            AND STOCK_RATE.COD_SCENARIO        = {PAR_0030}
*/            AND STOCK_RATE.COD_PERIODO         = IC_TO_BE_ADDED.COD_PERIODO
            AND STOCK_RATE.OWNING_COMPANY      = IC_TO_BE_ADDED.COD_AZIENDA
            AND STOCK_RATE.OWNED_COMPANY       = IC_TO_BE_ADDED.COD_AZI_CTP
        UNION ALL
        SELECT
            STOCK_RATE.COD_SCENARIO_ORIGINARIO, 
            {PAR_0010} AS COD_SCENARIO,
            STOCK_RATE.OWNED_COMPANY,
            STOCK_RATE.OWNING_COMPANY,
            STOCK_RATE.COD_PERIODO,
            STOCK_RATE.EQUITY_RATIO,
            STOCK_RATE.INTERACTION_FLAG,
            IC_TO_BE_ADDED2.COD_AZIENDA AS FLAG_CHK1,
            IC_TO_BE_ADDED2.COD_AZI_CTP AS FLAG_CHK2
        FROM
            STOCK_RATE
        LEFT JOIN
            IC_TO_BE_ADDED2
        ON
            STOCK_RATE.COD_SCENARIO_ORIGINARIO = IC_TO_BE_ADDED2.COD_SCENARIO
/*            AND STOCK_RATE.COD_SCENARIO        = {PAR_0010}
*/            AND STOCK_RATE.COD_PERIODO         = IC_TO_BE_ADDED2.COD_PERIODO
            AND STOCK_RATE.OWNING_COMPANY      = IC_TO_BE_ADDED2.COD_AZIENDA
            AND STOCK_RATE.OWNED_COMPANY       = IC_TO_BE_ADDED2.COD_AZI_CTP    
    ) AS STOCK_RATE_CHK
